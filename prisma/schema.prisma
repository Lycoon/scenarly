// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum UserRole {
  USER
  ADMIN
}

enum DataExportStatus {
  PENDING
  COMPLETED
  FAILED
}

// The paid plans. Each is an independent monthly subscription; a user can
// hold any combination. Cloud: sync, collaboration, version history.
enum Plan {
  CLOUD
}

// Which store bills a subscription: Stripe on the web and Windows, StoreKit on
// the App Store builds (iOS and macOS). One plan is only ever billed by one of
// them at a time.
enum SubscriptionProvider {
  STRIPE
  APPLE
}

model User {
  id                  String      @id @default(uuid(7))
  createdAt           DateTime    @default(now())
  email               String      @unique
  emailVerified       DateTime?
  username            String?
  color               String?
  role                UserRole    @default(USER)

  // Stripe is the source of truth for web billing; this only links the user to
  // it. It outlives any subscription so a lapsed user re-subscribes on the same
  // Stripe customer, keeping their payment method and invoice history.
  stripeCustomerId    String?     @unique

  settings            Json?

  accounts            Account[]
  sessions            Session[]
  projects            ProjectMember[]
  subscriptions       Subscription[]
  dataExports         DataExport[]
}

// One row per plan a user has bought, from whichever store billed it. The
// stores stay the source of truth for money; this mirrors just enough to gate
// features and to route their events. `expiresAt` in the past is a lapsed plan:
// the row is kept so an App Store resubscribe — which reuses the original
// transaction id — lands on the same account. Buying a plan through the other
// store replaces the row, which is what keeps one plan from being billed twice.
model Subscription {
  plan                Plan
  provider            SubscriptionProvider
  // Stripe subscription id, or Apple's original transaction id — the one every
  // renewal of an App Store subscription shares. Unique across the store so
  // one store subscription can only ever back one account.
  providerId          String
  expiresAt           DateTime
  // Will not renew: cancelled at period end (Stripe) or auto-renew off (Apple).
  cancelled           Boolean     @default(false)

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String

  @@id([userId, plan])
  @@unique([provider, providerId])
}

model Account {
  id                  String      @id @default(cuid())
  userId              String
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?     @db.Text
  access_token        String?     @db.Text
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?     @db.Text
  session_state       String?

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id                  String      @id @default(cuid())
  sessionToken        String      @unique
  userId              String
  expires             DateTime
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier          String
  token               String      @unique
  expires             DateTime

  @@unique([identifier, token])
}

model MagicLinkToken {
  id                  Int         @id @default(autoincrement())
  email               String
  tokenHash           String      @unique
  expiresAt           DateTime
  createdAt           DateTime    @default(now())

  desktopNonce        String?
  inviteToken         String?

  @@index([email, createdAt])
}

model Project {
  id                  String      @id @default(uuid(7))
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  title               String
  description         String?
  author              String?
  hasPoster           Boolean     @default(false)

  members             ProjectMember[]
  invitations         ProjectInvitation[]
  assets              ProjectAsset[]
}

// Tracking row for a cloud asset (board image / audio recording). The bytes live
// in R2 at `assets/{projectId}/{hash}`; this row records the size so per-owner
// storage usage can be summed across all projects a user owns. Content-addressed
// per project (mirrors the local IndexedDB store), so duplicates collapse.
model ProjectAsset {
  id                  String      @id @default(uuid(7))
  hash                String
  mime                String
  size                Int
  width               Int         @default(0)
  height              Int         @default(0)
  createdAt           DateTime    @default(now())

  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String

  @@unique([projectId, hash])
  @@index([projectId])
}

// One GDPR data-access request. The zip lives in R2 at `key` until `expiresAt`
// (7 days); any non-FAILED row younger than an hour blocks a new request.
model DataExport {
  id                  String            @id @default(uuid(7))
  status              DataExportStatus  @default(PENDING)
  key                 String?
  createdAt           DateTime          @default(now())
  completedAt         DateTime?
  expiresAt           DateTime?

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String

  @@index([userId])
}

model ProjectMember {
  id                  Int         @id @default(autoincrement())
  role                ProjectRole @default(VIEWER)

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String

  @@unique([userId, projectId])
}

model ProjectInvitation {
  id                   Int        @id @default(autoincrement())
  token                String     @unique
  email                String
  createdAt            DateTime   @default(now())

  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String

  @@unique([email, projectId])
}
